# Data
data <- c(14, 15, 9, 14, 8, 9, 6, 7, 8, 12)
# Sort the data
sorted_data <- sort(data)
# Function to compute percentile manually
get_percentile <- function(x, p) {
n <- length(x)
index <- (p / 100) * (n + 1)
if (index %% 1 == 0) {
# integer index
return(x[index])
} else {
# interpolate between two nearest ranks
lower <- floor(index)
upper <- ceiling(index)
return(x[lower] + (x[upper] - x[lower]) * (index - lower))
}
}
# 10th, 30th, 50th, and 75th percentiles
p10 <- get_percentile(sorted_data, 10)
p30 <- get_percentile(sorted_data, 30)
p50 <- get_percentile(sorted_data, 50)
p75 <- get_percentile(sorted_data, 75)
cat("10th percentile:", p10, "\n")
cat("30th percentile:", p30, "\n")
cat("50th percentile:", p50, "\n")
cat("75th percentile:", p75, "\n")
