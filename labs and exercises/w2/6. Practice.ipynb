    "def f1(my_dict):\n",
    "    temp=0\n",
    "    for value in my_dict.values():\n",
    "        temp = temp + value\n",
    "    return temp\n",
    "\n",
    "def f2(my_dict):\n",
    "    temp=''\n",
    "    for key in my_dict:\n",
    "        if temp < key:\n",
    "            temp=key\n",
    "    return temp\n",
    "    \n",
    "def f3(my_dict, k, v):\n",
    "    if k in my_dict:\n",
    "        my_dict[k] = v\n",
    "\n",
    "# main\n",
    "a_dict={'bill': 1, 'rich': 2, 'fred': 10, 'walter':20}\n",
    "print(f1(a_dict)) # Line 1 >>> answer adds them up >> 33\n",
    "print(f2(a_dict)) # Line 2 >> answer >>> empty string is shorter than Bill >> then check 2nd one >> Bill smaller than rich >> B is smaller than R >>>> Rich smaller than Walter it is >>> \n",
    "# # all string s with letters… greatest one is walter as no name after “W”\n",
    "print(None == f3(a_dict, 'bill', -1)) #Line 3 >> not returngin anything >> no key word “return” >> if not return word “None”…\n",
    "# is a side effect of F3 >> passing a dictionry >> check si K is in dict?>> then assign value of Bill to be -1…so before we had Bill1 >>> now it = -1 >>>\n",
    "print(a_dict) # Line 4  >> answer >>> Bill : -1 >> reason to change and reason not to change >>>> not change thinking these operations not reflect on main scope…. When passing a dict we’re apssing a reference >> when we do this kind of operation here we are changing a value\n",
