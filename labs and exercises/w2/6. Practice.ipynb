    "def f1(s1, s2, op=4):\n",
    "    if op==1:\n",
    "        temp = s1.intersection(s2) # is commutative....\n",
    "    elif op==2:\n",
    "        temp = s1.difference(s2) # is not the same as s2.differemnce s1.... not communattive\n",
    "    else:\n",
    "        temp = s1.union(s2)\n",
    "        return temp\n",
    "    \n",
    "set1=set('ab')\n",
    "set2= set('cd')\n",
    "print(f1(set1, set2)) # Line 1\n",
    "print(f1(set1, set2, 1)) # Line 2\n",
    "print(f1(set1, set2, 2)) # Line 3\n"
   ]
  },
